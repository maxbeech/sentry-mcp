# Read by Helm7 (and BuildKit) as <Dockerfile>.dockerignore. Only patterns both
# understand the same way are used: no "!" negations, and anything meant to
# match below the root is spelled with "**/" because Docker anchors every
# pattern to the root while Helm7 treats a slash-free one as any-depth. The
# Dockerfile names what it wants with COPY; this keeps the rest of the
# repository out of the tarball sent to the build host.

# Never wanted in an image.
.git
.github
.claude
.cursor
.cursor-plugin
.codex
.agents
.vscode
.env*
**/.env*
**/node_modules
**/dist
**/.turbo
**/*.log
**/.DS_Store

# Workspace packages @sentry/mcp-vercel does not depend on.
packages/mcp-cloudflare
packages/mcp-server
packages/mcp-server-evals
packages/mcp-test-client
packages/smoke-tests

# Repository material with no bearing on the build. Root-only on purpose:
# packages/mcp-core/scripts is needed by mcp-core's build.
/docs
/openspec
/ast-grep-rules
/ast-grep-rule-tests
/bin
/scripts
