{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": false,
    "incremental": false
  },
  // api/ is the Vercel entry and is not part of the container; tests would only
  // add vitest to the compiled output.
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
